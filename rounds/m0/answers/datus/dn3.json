  "sql": "SELECT substring(fcleardate, 1, 7) AS ym, SUM(fimamt) AS clear_amt\nFROM yunnan0508.fne_paybook_full_high\nWHERE fcleardate LIKE '2023-%'\nGROUP BY ym\nORDER BY ym",
