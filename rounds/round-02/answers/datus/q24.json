  "sql": "SELECT sum(CASE WHEN funddivide_transfer.fistransfer <> '1' THEN funddivide_transfer.ftransamt END) AS \"未划拨金额\", COUNT(DISTINCT funddivide_transfer.fcollectid) AS \"汇总批次数\" FROM yunnan0508.fne_funddivide_transfer AS funddivide_transfer LEFT JOIN yunnan0508.fne_paybook_full_high AS paybook_full_high ON funddivide_transfer.fpaybooksubid = paybook_full_high.fid WHERE paybook_full_high.fisreceived = '1' AND toDate(nullIf(paybook_full_high.freceiveddate, '')) >= '2023-11-08' AND toDate(nullIf(paybook_full_high.freceiveddate, '')) < '2024-11-02' SETTINGS join_use_nulls = 1",
