{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verdict（裁决书，每题一份跨双方；口径卡只在本层——M1 拍板 D10；2026-10-23 定版：口径卡 time_axis 细分为 dimensions+time_window，问题单=verdict_detail 数组（原 issues[] 完整迁入、条目结构不变），删 memory_cleanup/judge）",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "round", "cards", "comparison", "verdict", "verdict_detail",
               "corrected", "evidence_refs"],
  "properties": {
    "id": { "type": "string" },
    "round": { "type": "string" },
    "cards": {
      "type": "object",
      "required": ["datus", "cube"],
      "properties": {
        "datus": { "$ref": "#/$defs/caliberCard" },
        "cube": { "$ref": "#/$defs/caliberCard" }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "caliber_same", "value_same"],
            "properties": {
              "name": { "type": "string" },
              "caliber_same": { "type": ["boolean", "null"] },
              "value_same": { "type": ["boolean", "null"] },
              "note": { "type": "string" }
            },
            "description": "先比口径后比数值（D4）的机器形态；轮报一致率/分歧分布从这里数"
          }
        },
        "summary": { "type": "string", "description": "人类可读的口径对照汇总（可选）" }
      }
    },
    "verdict": { "enum": ["互证通过", "建模差异", "执行事故", "待人工"] },
    "verdict_detail": {
      "type": "array",
      "items": { "$ref": "#/$defs/issueItem" },
      "description": "问题单（原 issues[] 完整迁入，条目结构不变）：回改问题单的机器形态（0..n 条；互证通过通常为空数组），回改①的智能体据它起草回改单主表与回改卡；非空的题默认进下轮复验集（D12）"
    },
    "corrected": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": true,
          "required": ["answer", "basis"],
          "properties": { "answer": {}, "basis": { "type": "string" } }
        }
      ],
      "description": "修正答案（分歧题才有）；人工确认后随回改⑤闭环沉淀（feedback.md 行状态=闭环）"
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "items": { "type": "string" },
      "description": "指向双方作答卡的路径（限 git 库内证据；runs 留痕不入 git，也不入引用）"
    }
  },
  "$defs": {
    "issueItem": {
      "type": "object", "additionalProperties": true,
      "required": ["side", "type", "target", "suggest"],
      "properties": {
        "side": { "enum": ["datus", "cube", "both"], "description": "谁要动手；both=双侧都补建模" },
        "type": { "enum": ["补指标", "补维度", "改口径", "修bug"], "description": "补指标/补维度/改口径=建模动作；修bug=口径同值异的排错，不属建模" },
        "target": { "type": "string", "description": "动哪个建模对象（数据集/指标/维度/词典条目）" },
        "suggest": { "type": "string", "description": "建议修法" }
      }
    },
    "caliberCard": {
      "type": "object",
      "additionalProperties": true,
      "required": ["metric", "caliber", "dimensions", "time_window", "values"],
      "properties": {
        "metric": { "type": "string" },
        "caliber": { "type": "string", "description": "口径陈述：算什么、怎么去重、含哪些业务类型" },
        "dimensions": { "type": ["string", "null"], "description": "分组维度与粒度（如'按月聚月，仅金额一列'）；无分组或 nomatch 时 null" },
        "time_window": { "type": "string", "description": "时间锚点与窗口范围（如'锚点=开票日 ffilldate；窗口 [2026-01-01, 2027-01-01)'）" },
        "values": { "type": ["object", "null"], "description": "本侧数值；nomatch 时为 null" }
      }
    }
  }
}
