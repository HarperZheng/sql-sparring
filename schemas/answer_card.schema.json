{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "answer_card（作答卡，每题每方一份；答案唯一载体=值行 values，D14，2026-10-26 拍板：answer 字段自契约删除，散文只在 runs/ 留痕；m0 存档卡内的 answer 为历史遗留，不再被契约描述）",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "question", "status", "metrics_hit", "sql", "sql_count",
               "errors", "elapsed_s", "arbiter", "raw_path"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "question": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["answer", "ask", "nomatch", "timeout", "error", "failed"],
      "description": "六值超集（D10）：failed=适配器链路失败，error=智能体答错/中断，timeout=超时截断"
    },
    "metrics_hit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [{ "required": ["tool"] }, { "required": ["measures"] }],
        "description": "datus 形态 {tool,depth,names}（query_metrics 条目另带 dimensions/time_start/time_end 调用实参） / cube 形态 {measures,dimensions}；命中了哪些语义层指标（过程证据，纯机器提取）"
      }
    },
    "sql": { "type": ["string", "null"], "description": "双侧同放 SQL 文本（cube 为 :4000 编译后）" },
    "sql_count": { "type": "integer", "minimum": 0, "description": "执行 SQL 条数" },
    "values": {
      "type": "array",
      "description": "值行数组——答案唯一载体（D14，round-02 起迁移/round-03 起新卡必带）：每行 指标×维度成员→一个数+单位；只登记原始计量，合计/占比/排名等导出量不落行",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "unit", "dims", "value"],
        "properties": {
          "metric": { "type": "string", "minLength": 1,
                      "description": "指标名，取指标登记表 conf/metrics.json；登记表未收录时标 未登记:<名>，禁自造正名" },
          "unit": { "enum": ["元", "万元", "亿元", "笔", "张", "个", "天", "%"],
                    "description": "计量单位（枚举）；元/万元/亿元属金额量纲，比对时换算为元" },
          "dims": { "type": "object", "maxProperties": 2,
                    "additionalProperties": { "type": "string", "minLength": 1 },
                    "description": "维度成员（≤2 个），如 {\"月份\": \"2026-06\"}；无维度分解为空对象" },
          "value": { "type": ["number", "null"],
                     "description": "数值；null=该侧行存在但无数（如名单为空）" },
          "note": { "type": "string", "description": "可选旁注：成员名原文、口径说明等" }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" }, "description": "真实错误（非 KB 文本里的 Code NNN）" },
    "elapsed_s": { "type": "number", "minimum": 0 },
    "arbiter": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode", "policy", "first_type", "ask_question", "options", "followups"],
          "properties": {
            "mode": { "type": "string", "description": "auto=适配器自动拍板 / human=人在环" },
            "policy": { "type": "string" },
            "first_type": { "enum": ["answer", "ask", "nomatch"] },
            "ask_question": { "type": "string" },
            "options": { "type": "array" },
            "followups": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true,
                         "required": ["question", "response_type"] }
            }
          }
        }
      ],
      "description": "ask 态自动拍板全程记录；无拍板流为 null"
    },
    "raw_path": { "type": "string", "minLength": 1, "description": "原始留痕路径（runs/<侧>/，一字不改）" }
  }
}
